<%- include('partials/head', { title }) %>

<h2>명세기반 블랙박스 테스트케이스 자동 생성</h2>
<div class="card">
  <p style="color:#6b7280; font-size:13px; margin-top:0;">
    요구사항/기능 명세 문서(엑셀 .xlsx, 워드 .docx, PDF, 텍스트 .txt/.csv/.md)를 업로드하면 AI가 문서를 분석해
    <strong>ISO/IEC 25010</strong>(품질특성) · <strong>ISO/IEC 25023</strong>(품질측정지표) · <strong>ISO/IEC/IEEE 29119</strong>(테스트 설계기법:
    동등분할·경계값분석·결정테이블·상태전이 등) 표준을 적용한 블랙박스 테스트케이스를 자동 생성합니다.
    생성된 결과는 관리자 페이지에서 확인할 수 있습니다.
  </p>
  <div id="spec-not-configured" style="display:none; padding:12px; background:#fef3c7; border-radius:8px; font-size:13px; margin-bottom:12px;">
    AI 연동이 설정되지 않았습니다. 관리자에게 <code>ANTHROPIC_API_KEY</code> 환경변수 설정을 요청해 주세요.
  </div>
  <form class="stack" id="spec-test-form" onsubmit="return submitSpecTest(event)">
    <label>명세 문서 파일</label>
    <input type="file" id="spec-test-file" accept=".xlsx,.xls,.docx,.pdf,.txt,.csv,.md" required>
    <button class="btn" type="submit" id="spec-test-submit">테스트케이스 생성</button>
  </form>
  <div id="spec-test-message" style="margin-top:10px; font-size:13px;"></div>
</div>

<script>
  function specStatusCheck() {
    fetch('/spec-test/status')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && data.configured === false) {
          document.getElementById('spec-not-configured').style.display = 'block';
          document.getElementById('spec-test-submit').disabled = true;
        }
      })
      .catch(function () {
        // 비관리자는 /spec-test/status 조회 권한이 없어(401) 여기로 올 수 있다. 업로드 자체는 계속 가능하다.
      });
  }
  specStatusCheck();

  function submitSpecTest(e) {
    e.preventDefault();
    const btn = document.getElementById('spec-test-submit');
    const msg = document.getElementById('spec-test-message');
    const fileInput = document.getElementById('spec-test-file');
    if (!fileInput.files.length) return false;

    btn.disabled = true;
    msg.style.color = '#6b7280';
    msg.textContent = '파일을 업로드하는 중...';

    const formData = new FormData();
    formData.append('document', fileInput.files[0]);

    fetch('/spec-test/upload', { method: 'POST', body: formData })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) {
          msg.style.color = '#dc2626';
          msg.textContent = '오류: ' + (data.error || '알 수 없는 오류');
          btn.disabled = false;
          return;
        }
        msg.style.color = '#16a34a';
        msg.textContent = data.truncated
          ? '업로드 완료 (문서가 길어 일부 내용만 사용됩니다). 관리자 승인 후 테스트케이스 생성이 시작됩니다.'
          : '업로드 완료. 관리자 승인 후 테스트케이스 생성이 시작됩니다.';
        setTimeout(function () { btn.disabled = false; }, 3000);
        fileInput.value = '';
      })
      .catch(function (err) {
        msg.style.color = '#dc2626';
        msg.textContent = '오류: ' + err.message;
        btn.disabled = false;
      });
    return false;
  }
</script>

<h2>웹사이트 종합 검사</h2>
<div class="card">
  <p style="color:#6b7280; font-size:13px; margin-top:0;">
    검사할 웹사이트 주소를 입력하면 기능(Playwright: 접속성·콘솔에러·깨진링크·접근성) · 성능(k6) · API/HTTP 응답 검증을 자동으로 실행합니다.
    결과는 관리자 페이지에서 확인할 수 있습니다.
  </p>
  <form class="stack" id="site-audit-form" onsubmit="return submitSiteAudit(event)">
    <label>웹사이트 주소</label>
    <input type="url" id="site-audit-url" required placeholder="https://example.com">
    <button class="btn" type="submit" id="site-audit-submit">검사 실행</button>
  </form>
  <div id="site-audit-message" style="margin-top:10px; font-size:13px;"></div>
</div>

<script>
  function submitSiteAudit(e) {
    e.preventDefault();
    const btn = document.getElementById('site-audit-submit');
    const msg = document.getElementById('site-audit-message');
    const url = document.getElementById('site-audit-url').value;

    btn.disabled = true;
    msg.style.color = '#6b7280';
    msg.textContent = '검사를 요청하는 중...';

    fetch('/site-audit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url }),
    })
      .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
      .then(function (result) {
        if (!result.data.ok) {
          msg.style.color = '#dc2626';
          msg.textContent = '오류: ' + (result.data.error || '알 수 없는 오류');
          btn.disabled = false;
          return;
        }
        msg.style.color = '#16a34a';
        msg.textContent = '검사가 시작되었습니다. 결과는 관리자 페이지에서 확인해 주세요.';
        setTimeout(function () { btn.disabled = false; }, 3000);
      })
      .catch(function (err) {
        msg.style.color = '#dc2626';
        msg.textContent = '오류: ' + err.message;
        btn.disabled = false;
      });
    return false;
  }
</script>

<h2>CI/CD 자동 테스트 실행 요청</h2>
<div class="card">
  <p style="color:#6b7280; font-size:13px; margin-top:0;">
    단위테스트(Jest) → 통합/E2E테스트(Playwright) → 성능테스트(k6) → 보안점검(npm audit) 순서로 자동 실행되는
    CI/CD 파이프라인의 실행을 요청할 수 있습니다. GitHub Actions 실행은 컴퓨팅 자원을 소모하므로,
    요청 내용을 관리자가 확인하고 <strong>승인</strong>해야만 실제 실행이 시작됩니다. 결과는 관리자 페이지에서 확인할 수 있습니다.
  </p>
  <form class="stack" id="ci-test-form" onsubmit="return submitCiTest(event)">
    <label>테스트 대상 URL (선택)</label>
    <input type="url" id="ci-test-url" placeholder="https://example.com">
    <label>요청사항</label>
    <textarea id="ci-test-requirements" rows="3" required placeholder="예: 로그인 폼과 결제 API 응답을 중점적으로 확인해 주세요."></textarea>
    <button class="btn" type="submit" id="ci-test-submit">실행 요청</button>
  </form>
  <div id="ci-test-message" style="margin-top:10px; font-size:13px;"></div>
</div>

<script>
  function submitCiTest(e) {
    e.preventDefault();
    const btn = document.getElementById('ci-test-submit');
    const msg = document.getElementById('ci-test-message');
    const targetUrl = document.getElementById('ci-test-url').value;
    const requirements = document.getElementById('ci-test-requirements').value;

    btn.disabled = true;
    msg.style.color = '#6b7280';
    msg.textContent = '실행을 요청하는 중...';

    fetch('/ci-test/request', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ targetUrl, requirements }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) {
          msg.style.color = '#dc2626';
          msg.textContent = '오류: ' + (data.error || '알 수 없는 오류');
          btn.disabled = false;
          return;
        }
        msg.style.color = '#16a34a';
        msg.textContent = '요청이 접수되었습니다. 관리자 승인 후 테스트 실행이 시작됩니다.';
        document.getElementById('ci-test-requirements').value = '';
        document.getElementById('ci-test-url').value = '';
        setTimeout(function () { btn.disabled = false; }, 3000);
      })
      .catch(function (err) {
        msg.style.color = '#dc2626';
        msg.textContent = '오류: ' + err.message;
        btn.disabled = false;
      });
    return false;
  }
</script>

<h2>테스트 프로세스별 자동화 에이전트 · MCP 추천</h2>
<p class="lead">요구사항분석부터 배포/모니터링까지, SDLC 7단계에 맞는 자동화 도구를 추천합니다. 사용자 피드백이 쌓일수록 추천 품질이 점점 좋아집니다.</p>

<div class="stage-grid">
  <% stages.forEach(function(stage) { %>
    <a class="stage-card" href="/stages/<%= stage.id %>">
      <span class="stage-order"><%= stage.order %></span>
      <h3><%= stage.name %></h3>
      <p><%= stage.description %></p>
    </a>
  <% }) %>
</div>

