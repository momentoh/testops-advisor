<%- include('partials/head', { title }) %>

<div style="display:flex; justify-content:space-between; align-items:center;">
  <h1>관리자 대시보드</h1>
  <form method="POST" action="/admin/logout"><button class="btn secondary" type="submit">로그아웃</button></form>
</div>

<h2>요구사양서 리뷰 이력</h2>
<div class="card">
  <p style="color:#6b7280; font-size:13px; margin-top:0;">
    홈페이지의 "요구사양서 리뷰" 업로드 폼으로 요청된 이력입니다. 최근 30건까지 보관됩니다.
    ISO/IEC/IEEE 29148 · IEEE 830 · ISO/IEC 25030 · ISO/IEC 25010 · ISO/IEC 12207 표준을 기준으로 리뷰합니다.
    AI 리뷰는 토큰(비용)을 소모하므로, <strong>승인 대기</strong> 상태의 요청은 관리자가 문서 미리보기를 확인한 뒤
    승인해야만 실제 리뷰가 시작되며, 반려하면 비용 없이 종료됩니다.
  </p>
  <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:12px; font-size:13px;">
    <label>기간:</label>
    <input type="date" id="req-filter-from" style="padding:4px 8px; border:1px solid #d1d5db; border-radius:6px;">
    <span>~</span>
    <input type="date" id="req-filter-to" style="padding:4px 8px; border:1px solid #d1d5db; border-radius:6px;">
    <button class="btn secondary" type="button" style="padding:4px 10px; font-size:12px;" onclick="applyReqFilter()">조회</button>
    <button class="btn secondary" type="button" style="padding:4px 10px; font-size:12px;" onclick="clearReqFilter()">전체보기</button>
    <span id="req-filter-count" style="color:#6b7280;"></span>
  </div>
  <div id="req-admin-empty" style="display:none; color:#9ca3af; font-size:13px;">아직 생성된 리뷰가 없습니다.</div>
  <table class="admin-table" id="req-admin-table" style="display:none;">
    <thead><tr><th>파일명</th><th>요청 시각</th><th>상태</th><th>총평</th><th>발견사항 수</th><th>승인/반려</th></tr></thead>
    <tbody id="req-admin-body"></tbody>
  </table>
  <div id="req-admin-detail" style="display:none; margin-top:16px;"></div>
</div>

<script>
  let reqAdminCache = {};
  let reqAdminAllItems = []; // 필터 적용 전 전체 이력 (요청 시각 기준 최신순)
  let reqFilterFrom = null;  // 'YYYY-MM-DD' 또는 null(제한 없음)
  let reqFilterTo = null;

  function applyReqFilter() {
    reqFilterFrom = document.getElementById('req-filter-from').value || null;
    reqFilterTo = document.getElementById('req-filter-to').value || null;
    renderReqAdminList(reqAdminAllItems);
  }

  function clearReqFilter() {
    document.getElementById('req-filter-from').value = '';
    document.getElementById('req-filter-to').value = '';
    reqFilterFrom = null;
    reqFilterTo = null;
    renderReqAdminList(reqAdminAllItems);
  }

  function filterByDateRange(items, from, to) {
    if (!from && !to) return items;
    return items.filter(function (item) {
      const d = new Date(item.requestedAt);
      const dateStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
      if (from && dateStr < from) return false;
      if (to && dateStr > to) return false;
      return true;
    });
  }

  function reqAdminStatusLabel(status) {
    if (status === 'done') return { text: '✅ 완료', color: '#16a34a' };
    if (status === 'error') return { text: '❌ 실패', color: '#dc2626' };
    if (status === 'pending_approval') return { text: '🔔 승인 대기', color: '#d97706' };
    if (status === 'rejected') return { text: '🚫 반려됨', color: '#6b7280' };
    return { text: '⏳ 처리 중', color: '#d97706' };
  }

  function reqScoreBadge(score) {
    const color = score === '상' ? '#16a34a' : score === '중' ? '#d97706' : score === '하' ? '#dc2626' : '#6b7280';
    return '<span style="display:inline-block; background:' + color + '1a; color:' + color + '; border-radius:999px; padding:2px 10px; font-size:12px; font-weight:600;">' + (score || '-') + '</span>';
  }

  function reqSeverityColor(severity) {
    if (severity === '높음') return '#dc2626';
    if (severity === '중간') return '#d97706';
    return '#6b7280';
  }

  function approveReqReview(id) {
    if (!confirm('이 요청을 승인하시겠습니까? 승인 시 AI 호출(토큰 소모)이 시작됩니다.')) return;
    fetch('/admin/req-review/' + id + '/approve', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) { alert('오류: ' + (data.error || '알 수 없는 오류')); return; }
        pollReqAdminStatus();
      })
      .catch(function (err) { alert('오류: ' + err.message); });
  }

  function rejectReqReview(id) {
    if (!confirm('이 요청을 반려하시겠습니까? 반려 시 AI 호출 없이 종료됩니다 (토큰 미소모).')) return;
    fetch('/admin/req-review/' + id + '/reject', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason: '관리자가 반려했습니다.' }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) { alert('오류: ' + (data.error || '알 수 없는 오류')); return; }
        pollReqAdminStatus();
      })
      .catch(function (err) { alert('오류: ' + err.message); });
  }

  function renderReqAdminDetail(item) {
    const box = document.getElementById('req-admin-detail');
    box.style.display = 'block';

    if (item.status === 'pending_approval') {
      box.innerHTML =
        '<div style="padding:12px; background:#fffbeb; border-radius:8px; font-size:13px;">' +
        '<div style="font-weight:600; margin-bottom:6px;">🔔 승인 대기 중 — 문서 미리보기 (앞부분 일부)</div>' +
        '<pre style="white-space:pre-wrap; max-height:240px; overflow:auto; background:#fff; padding:10px; border-radius:6px; font-size:12px; border:1px solid #fde68a;">' +
        (item.previewText || '(미리보기 없음)').replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</pre>' +
        '<div style="margin-top:10px;">' +
        '<button class="btn" type="button" onclick="approveReqReview(\'' + item.id + '\')">승인 (리뷰 시작)</button> ' +
        '<button class="btn secondary" type="button" onclick="rejectReqReview(\'' + item.id + '\')">반려</button>' +
        '</div></div>';
      return;
    }
    if (item.status === 'rejected') {
      box.innerHTML = '<div style="color:#6b7280; font-size:13px;">🚫 반려된 요청입니다' + (item.error ? ' (' + item.error + ')' : '') + '. AI 호출이 발생하지 않아 토큰이 소모되지 않았습니다.</div>';
      return;
    }
    if (item.status === 'error') {
      box.innerHTML = '<div style="color:#dc2626; font-size:13px;">❌ 리뷰 실패: ' + item.error + '</div>';
      return;
    }
    if (item.status !== 'done') {
      box.innerHTML = '<div style="color:#d97706; font-size:13px;">⏳ 처리 중입니다.</div>';
      return;
    }

    let html = '<div style="margin-bottom:10px;">' +
      '<a class="btn secondary" style="padding:4px 10px; font-size:12px; text-decoration:none;" href="/admin/req-review/' + item.id + '/export/xlsx">엑셀로 내보내기</a> ' +
      '<a class="btn secondary" style="padding:4px 10px; font-size:12px; text-decoration:none;" href="/admin/req-review/' + item.id + '/export/docx">워드로 내보내기</a> ' +
      '<a class="btn secondary" style="padding:4px 10px; font-size:12px; text-decoration:none;" href="/admin/req-review/' + item.id + '/export/html">HTML로 내보내기</a> ' +
      '<a class="btn secondary" style="padding:4px 10px; font-size:12px; text-decoration:none;" href="/admin/req-review/' + item.id + '/export/print" target="_blank">PDF로 저장 (인쇄용 페이지 열기)</a>' +
      '</div>';

    html += '<p style="font-size:13px; background:#f9fafb; padding:10px 12px; border-radius:8px;">' +
      '<strong>문서 요약:</strong> ' + item.summary + '<br>' +
      '<strong>전체 총평:</strong> ' + reqScoreBadge(item.overallScore) +
      '</p>';

    html += '<table class="admin-table"><thead><tr><th>적용 표준</th><th>등급</th><th>총평</th></tr></thead><tbody>';
    (item.standardScores || []).forEach(function (s) {
      html += '<tr><td>' + s.standard + '</td><td>' + reqScoreBadge(s.score) + '</td><td>' + s.comment + '</td></tr>';
    });
    html += '</tbody></table>';

    if (item.missingQualityCharacteristics && item.missingQualityCharacteristics.length) {
      html += '<div style="margin-top:12px; padding:10px 12px; background:#fef2f2; border-radius:8px; font-size:13px;">' +
        '<strong>누락된 ISO/IEC 25010 품질특성:</strong> ' + item.missingQualityCharacteristics.join(', ') + '</div>';
    }
    if (item.strengths && item.strengths.length) {
      html += '<div style="margin-top:8px; padding:10px 12px; background:#f0fdf4; border-radius:8px; font-size:13px;">' +
        '<strong>잘 작성된 부분:</strong> ' + item.strengths.join(' · ') + '</div>';
    }

    html += '<table class="admin-table" style="margin-top:14px;"><thead><tr><th>ID</th><th>관련 표준 / 유형</th><th>위치</th><th>문제점 / 개선 제안</th><th>심각도</th></tr></thead><tbody>';
    (item.findings || []).forEach(function (f) {
      html += '<tr>' +
        '<td>' + f.id + '</td>' +
        '<td><span style="display:inline-block; background:#eef2ff; color:#4338ca; border-radius:999px; padding:2px 8px; font-size:11px;">' + f.standard + '</span><br>' +
          '<span style="color:#6b7280; font-size:12px;">' + f.category + '</span></td>' +
        '<td>' + (f.location || '-') + '</td>' +
        '<td><strong>문제:</strong> ' + f.issue + '<br><strong>제안:</strong> ' + f.recommendation + '</td>' +
        '<td style="color:' + reqSeverityColor(f.severity) + '">' + (f.severity || '-') + '</td>' +
        '</tr>';
    });
    html += '</tbody></table>';
    box.innerHTML = html;
  }

  function viewReqAdminItem(id) {
    const item = reqAdminCache[id];
    if (!item) return;
    renderReqAdminDetail(item);
    document.getElementById('req-admin-detail').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderReqAdminList(allItems) {
    const items = filterByDateRange(allItems, reqFilterFrom, reqFilterTo);
    const empty = document.getElementById('req-admin-empty');
    const table = document.getElementById('req-admin-table');
    const body = document.getElementById('req-admin-body');
    const countLabel = document.getElementById('req-filter-count');

    countLabel.textContent = (reqFilterFrom || reqFilterTo)
      ? '(' + items.length + '건 / 전체 ' + allItems.length + '건)'
      : '';

    if (items.length === 0) {
      empty.style.display = 'block';
      empty.textContent = allItems.length === 0 ? '아직 생성된 리뷰가 없습니다.' : '선택한 기간에 해당하는 이력이 없습니다.';
      table.style.display = 'none';
      return;
    }
    empty.style.display = 'none';
    table.style.display = '';
    body.innerHTML = '';
    reqAdminCache = {};

    items.forEach(function (item) {
      reqAdminCache[item.id] = item;
      const s = reqAdminStatusLabel(item.status);
      const findingCount = (item.findings || []).length;
      const clickable = item.status === 'done' || item.status === 'pending_approval' || item.status === 'rejected';
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + item.filename + '</td>' +
        '<td>' + new Date(item.requestedAt).toLocaleString('ko-KR') + '</td>' +
        '<td><span ' + (clickable ? 'class="job-status-link" onclick="viewReqAdminItem(\'' + item.id + '\')" style="cursor:pointer; text-decoration:underline;"' : '') +
          ' style="color:' + s.color + '">' + s.text + '</span></td>' +
        '<td>' + (item.status === 'done' ? reqScoreBadge(item.overallScore) : '-') + '</td>' +
        '<td>' + (item.status === 'done' ? findingCount + '건' : '-') + '</td>' +
        '<td>' + (item.status === 'pending_approval'
          ? '<button class="btn" type="button" style="padding:2px 10px; font-size:12px;" onclick="approveReqReview(\'' + item.id + '\')">승인</button> ' +
            '<button class="btn secondary" type="button" style="padding:2px 10px; font-size:12px;" onclick="rejectReqReview(\'' + item.id + '\')">반려</button>'
          : '-') + '</td>';
      body.appendChild(tr);
    });
  }

  function pollReqAdminStatus() {
    fetch('/req-review/status')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        const items = data.items || [];
        reqAdminAllItems = items;
        renderReqAdminList(items);

        const hasProcessing = items.some(function (item) { return item.status === 'processing'; });
        if (hasProcessing && !window.__reqAdminPolling) {
          window.__reqAdminPolling = setInterval(pollReqAdminStatus, 5000);
        } else if (!hasProcessing && window.__reqAdminPolling) {
          clearInterval(window.__reqAdminPolling);
          window.__reqAdminPolling = null;
        }
      })
      .catch(function () {});
  }

  pollReqAdminStatus();
</script>

<h2>명세기반 블랙박스 테스트케이스 생성 이력</h2>
<div class="card">
  <p style="color:#6b7280; font-size:13px; margin-top:0;">
    홈페이지의 "명세기반 블랙박스 테스트케이스 자동 생성" 업로드 폼으로 요청된 이력입니다. 최근 30건까지 보관됩니다.
    AI 생성은 토큰(비용)을 소모하므로, <strong>승인 대기</strong> 상태의 요청은 관리자가 문서 미리보기를 확인한 뒤
    승인해야만 실제 생성이 시작되며, 반려하면 비용 없이 종료됩니다.
  </p>
  <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:12px; font-size:13px;">
    <label>기간:</label>
    <input type="date" id="spec-filter-from" style="padding:4px 8px; border:1px solid #d1d5db; border-radius:6px;">
    <span>~</span>
    <input type="date" id="spec-filter-to" style="padding:4px 8px; border:1px solid #d1d5db; border-radius:6px;">
    <button class="btn secondary" type="button" style="padding:4px 10px; font-size:12px;" onclick="applySpecFilter()">조회</button>
    <button class="btn secondary" type="button" style="padding:4px 10px; font-size:12px;" onclick="clearSpecFilter()">전체보기</button>
    <span id="spec-filter-count" style="color:#6b7280;"></span>
  </div>
  <div id="spec-admin-empty" style="display:none; color:#9ca3af; font-size:13px;">아직 생성된 테스트케이스가 없습니다.</div>
  <table class="admin-table" id="spec-admin-table" style="display:none;">
    <thead><tr><th>파일명</th><th>요청 시각</th><th>상태</th><th>테스트케이스 수</th><th>승인/반려</th></tr></thead>
    <tbody id="spec-admin-body"></tbody>
  </table>
  <div id="spec-admin-detail" style="display:none; margin-top:16px;"></div>
</div>

<script>
  let specAdminCache = {};
  let specAdminAllItems = [];
  let specFilterFrom = null;
  let specFilterTo = null;

  function applySpecFilter() {
    specFilterFrom = document.getElementById('spec-filter-from').value || null;
    specFilterTo = document.getElementById('spec-filter-to').value || null;
    renderSpecAdminList(specAdminAllItems);
  }

  function clearSpecFilter() {
    document.getElementById('spec-filter-from').value = '';
    document.getElementById('spec-filter-to').value = '';
    specFilterFrom = null;
    specFilterTo = null;
    renderSpecAdminList(specAdminAllItems);
  }

  function specAdminStatusLabel(status) {
    if (status === 'done') return { text: '✅ 완료', color: '#16a34a' };
    if (status === 'error') return { text: '❌ 실패', color: '#dc2626' };
    if (status === 'pending_approval') return { text: '🔔 승인 대기', color: '#d97706' };
    if (status === 'rejected') return { text: '🚫 반려됨', color: '#6b7280' };
    return { text: '⏳ 처리 중', color: '#d97706' };
  }

  function approveSpecTest(id) {
    if (!confirm('이 요청을 승인하시겠습니까? 승인 시 AI 호출(토큰 소모)이 시작됩니다.')) return;
    fetch('/admin/spec-test/' + id + '/approve', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) { alert('오류: ' + (data.error || '알 수 없는 오류')); return; }
        pollSpecAdminStatus();
      })
      .catch(function (err) { alert('오류: ' + err.message); });
  }

  function rejectSpecTest(id) {
    if (!confirm('이 요청을 반려하시겠습니까? 반려 시 AI 호출 없이 종료됩니다 (토큰 미소모).')) return;
    fetch('/admin/spec-test/' + id + '/reject', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason: '관리자가 반려했습니다.' }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) { alert('오류: ' + (data.error || '알 수 없는 오류')); return; }
        pollSpecAdminStatus();
      })
      .catch(function (err) { alert('오류: ' + err.message); });
  }

  function renderSpecAdminDetail(item) {
    const box = document.getElementById('spec-admin-detail');
    box.style.display = 'block';

    if (item.status === 'pending_approval') {
      box.innerHTML =
        '<div style="padding:12px; background:#fffbeb; border-radius:8px; font-size:13px;">' +
        '<div style="font-weight:600; margin-bottom:6px;">🔔 승인 대기 중 — 문서 미리보기 (앞부분 일부)</div>' +
        '<pre style="white-space:pre-wrap; max-height:240px; overflow:auto; background:#fff; padding:10px; border-radius:6px; font-size:12px; border:1px solid #fde68a;">' +
        (item.previewText || '(미리보기 없음)').replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</pre>' +
        '<div style="margin-top:10px;">' +
        '<button class="btn" type="button" onclick="approveSpecTest(\'' + item.id + '\')">승인 (생성 시작)</button> ' +
        '<button class="btn secondary" type="button" onclick="rejectSpecTest(\'' + item.id + '\')">반려</button>' +
        '</div></div>';
      return;
    }
    if (item.status === 'rejected') {
      box.innerHTML = '<div style="color:#6b7280; font-size:13px;">🚫 반려된 요청입니다' + (item.error ? ' (' + item.error + ')' : '') + '. AI 호출이 발생하지 않아 토큰이 소모되지 않았습니다.</div>';
      return;
    }
    if (item.status === 'error') {
      box.innerHTML = '<div style="color:#dc2626; font-size:13px;">❌ 생성 실패: ' + item.error + '</div>';
      return;
    }
    if (item.status !== 'done') {
      box.innerHTML = '<div style="color:#d97706; font-size:13px;">⏳ 처리 중입니다.</div>';
      return;
    }

    let html = '<div style="margin-bottom:10px;">' +
      '<a class="btn secondary" style="padding:4px 10px; font-size:12px; text-decoration:none;" href="/admin/spec-test/' + item.id + '/export/xlsx">엑셀로 내보내기</a> ' +
      '<a class="btn secondary" style="padding:4px 10px; font-size:12px; text-decoration:none;" href="/admin/spec-test/' + item.id + '/export/docx">워드로 내보내기</a> ' +
      '<a class="btn secondary" style="padding:4px 10px; font-size:12px; text-decoration:none;" href="/admin/spec-test/' + item.id + '/export/html">HTML로 내보내기</a> ' +
      '<a class="btn secondary" style="padding:4px 10px; font-size:12px; text-decoration:none;" href="/admin/spec-test/' + item.id + '/export/print" target="_blank">PDF로 저장 (인쇄용 페이지 열기)</a>' +
      '</div>';

    html += '<p style="font-size:13px; background:#f9fafb; padding:10px 12px; border-radius:8px;"><strong>문서 요약:</strong> ' + item.summary + '</p>';
    html += '<table class="admin-table"><thead><tr><th>ID</th><th>제목 / 요구사항</th><th>표준 매핑</th><th>절차 · 데이터 · 기대결과</th><th>우선순위</th></tr></thead><tbody>';
    (item.testCases || []).forEach(function (tc) {
      const steps = (tc.steps || []).map(function (s) { return '<li>' + s + '</li>'; }).join('');
      html += '<tr>' +
        '<td>' + tc.id + '</td>' +
        '<td><strong>' + tc.title + '</strong><br><span style="color:#6b7280; font-size:12px;">' + tc.requirement + '</span></td>' +
        '<td><span style="display:inline-block; background:#eef2ff; color:#4338ca; border-radius:999px; padding:2px 8px; font-size:11px;">25010: ' + tc.iso25010 + '</span><br>' +
          '<span style="display:inline-block; background:#eef2ff; color:#4338ca; border-radius:999px; padding:2px 8px; font-size:11px; margin-top:4px;">29119: ' + tc.designTechnique + '</span></td>' +
        '<td><strong>사전조건:</strong> ' + (tc.preconditions || '-') + '<br>' +
          '<strong>절차:</strong><ol style="margin:4px 0; padding-left:18px;">' + steps + '</ol>' +
          '<strong>테스트 데이터:</strong> ' + (tc.testData || '-') + '<br>' +
          '<strong>기대 결과:</strong> ' + (tc.expectedResult || '-') +
        '</td>' +
        '<td>' + (tc.priority || '-') + '</td>' +
        '</tr>';
    });
    html += '</tbody></table>';
    box.innerHTML = html;
  }

  function viewSpecAdminItem(id) {
    const item = specAdminCache[id];
    if (!item) return;
    renderSpecAdminDetail(item);
    document.getElementById('spec-admin-detail').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderSpecAdminList(allItems) {
    const items = filterByDateRange(allItems, specFilterFrom, specFilterTo);
    const empty = document.getElementById('spec-admin-empty');
    const table = document.getElementById('spec-admin-table');
    const body = document.getElementById('spec-admin-body');
    const countLabel = document.getElementById('spec-filter-count');

    countLabel.textContent = (specFilterFrom || specFilterTo)
      ? '(' + items.length + '건 / 전체 ' + allItems.length + '건)'
      : '';

    if (items.length === 0) {
      empty.style.display = 'block';
      empty.textContent = allItems.length === 0 ? '아직 생성된 테스트케이스가 없습니다.' : '선택한 기간에 해당하는 이력이 없습니다.';
      table.style.display = 'none';
      return;
    }
    empty.style.display = 'none';
    table.style.display = '';
    body.innerHTML = '';
    specAdminCache = {};

    items.forEach(function (item) {
      specAdminCache[item.id] = item;
      const s = specAdminStatusLabel(item.status);
      const count = (item.testCases || []).length;
      const clickable = item.status === 'done' || item.status === 'pending_approval' || item.status === 'rejected';
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + item.filename + '</td>' +
        '<td>' + new Date(item.requestedAt).toLocaleString('ko-KR') + '</td>' +
        '<td><span ' + (clickable ? 'class="job-status-link" onclick="viewSpecAdminItem(\'' + item.id + '\')" style="cursor:pointer; text-decoration:underline;"' : '') +
          ' style="color:' + s.color + '">' + s.text + '</span></td>' +
        '<td>' + (item.status === 'done' ? count + '개' : '-') + '</td>' +
        '<td>' + (item.status === 'pending_approval'
          ? '<button class="btn" type="button" style="padding:2px 10px; font-size:12px;" onclick="approveSpecTest(\'' + item.id + '\')">승인</button> ' +
            '<button class="btn secondary" type="button" style="padding:2px 10px; font-size:12px;" onclick="rejectSpecTest(\'' + item.id + '\')">반려</button>'
          : '-') + '</td>';
      body.appendChild(tr);
    });
  }

  function pollSpecAdminStatus() {
    fetch('/spec-test/status')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        const items = data.items || [];
        specAdminAllItems = items;
        renderSpecAdminList(items);

        const hasProcessing = items.some(function (item) { return item.status === 'processing'; });
        if (hasProcessing && !window.__specAdminPolling) {
          window.__specAdminPolling = setInterval(pollSpecAdminStatus, 5000);
        } else if (!hasProcessing && window.__specAdminPolling) {
          clearInterval(window.__specAdminPolling);
          window.__specAdminPolling = null;
        }
      })
      .catch(function () {});
  }

  pollSpecAdminStatus();
</script>

<h2>웹사이트 검사 결과 (프론트 "웹사이트 종합 검사" 폼)</h2>
<div class="card">
  <p style="color:#6b7280; font-size:13px; margin-top:0;">
    홈페이지에서 사용자가 제출한 가장 최근 검사 요청의 결과입니다. 기능(Playwright) → 성능(k6) → API/HTTP 응답 검증 순서로 실행됩니다.
  </p>
  <div id="sa-not-configured" style="display:none; padding:12px; background:#fef3c7; border-radius:8px; font-size:13px;">
    GitHub 연동이 설정되지 않았습니다. <code>GITHUB_TOKEN</code>, <code>GITHUB_REPO</code> 환경변수를 확인해 주세요.
  </div>
  <div id="sa-no-request" style="display:none; color:#9ca3af; font-size:13px;">
    아직 제출된 검사 요청이 없습니다.
  </div>
  <div id="sa-content" style="display:none;">
    <p style="font-size:13px;">
      <strong>대상 URL:</strong> <span id="sa-url"></span><br>
      <strong>요청 시각:</strong> <span id="sa-requested-at"></span><br>
      <strong>전체 상태:</strong> <span id="sa-overall"></span>
    </p>
    <table class="admin-table" id="sa-jobs-table">
      <thead><tr><th>단계</th><th>상태</th><th>소요 시간</th></tr></thead>
      <tbody id="sa-jobs-body"></tbody>
    </table>
    <div id="sa-run-link" style="margin-top:10px; font-size:13px;"></div>
    <p style="color:#6b7280; font-size:12px; margin-top:10px;">
      상세 로그(콘솔 에러, 깨진 링크 목록, HTTP 헤더 등)는 "GitHub Actions에서 자세히 보기" 링크의 각 단계 로그에서 확인할 수 있습니다.
    </p>
  </div>
</div>

<script>
  let saPolling = null;

  function saStatusLabel(status, conclusion) {
    if (status === 'completed') {
      if (conclusion === 'success') return { text: '✅ 통과', color: '#16a34a' };
      if (conclusion === 'failure') return { text: '❌ 실패', color: '#dc2626' };
      return { text: conclusion || status, color: '#6b7280' };
    }
    if (status === 'in_progress') return { text: '⏳ 진행 중', color: '#d97706' };
    if (status === 'queued') return { text: '⏳ 대기 중', color: '#6b7280' };
    return { text: status, color: '#6b7280' };
  }

  function saFormatDuration(startedAt, completedAt) {
    if (!startedAt) return '-';
    const end = completedAt ? new Date(completedAt) : new Date();
    const sec = Math.max(0, Math.round((end - new Date(startedAt)) / 1000));
    return sec + '초';
  }

  function renderSiteAuditStatus(data) {
    const notConfigured = document.getElementById('sa-not-configured');
    const noRequest = document.getElementById('sa-no-request');
    const content = document.getElementById('sa-content');

    if (!data.configured) {
      notConfigured.style.display = 'block';
      noRequest.style.display = 'none';
      content.style.display = 'none';
      return;
    }
    notConfigured.style.display = 'none';

    if (!data.last) {
      noRequest.style.display = 'block';
      content.style.display = 'none';
      return;
    }
    noRequest.style.display = 'none';
    content.style.display = 'block';

    document.getElementById('sa-url').textContent = data.last.targetUrl;
    document.getElementById('sa-requested-at').textContent = new Date(data.last.requestedAt).toLocaleString('ko-KR');

    const overallEl = document.getElementById('sa-overall');
    if (!data.run) {
      overallEl.textContent = '실행 정보를 아직 가져오지 못했습니다 (잠시 후 갱신됩니다).';
      overallEl.style.color = '#6b7280';
      return;
    }

    const overall = saStatusLabel(data.run.status, data.run.conclusion);
    overallEl.textContent = overall.text;
    overallEl.style.color = overall.color;

    const body = document.getElementById('sa-jobs-body');
    body.innerHTML = '';
    (data.jobs || []).forEach(function (j) {
      const s = saStatusLabel(j.status, j.conclusion);
      const tr = document.createElement('tr');
      const canDetail = j.status === 'completed';
      tr.innerHTML =
        '<td>' + j.name + '</td>' +
        '<td><span ' + (canDetail ? 'class="job-status-link" onclick="toggleSaDetail(\'' + j.id + '\')"' : '') +
          ' style="color:' + s.color + (canDetail ? ';cursor:pointer;text-decoration:underline;' : '') + '">' + s.text + '</span></td>' +
        '<td>' + saFormatDuration(j.startedAt, j.completedAt) + '</td>';
      body.appendChild(tr);

      if (canDetail) {
        const detailTr = document.createElement('tr');
        detailTr.id = 'sa-detail-row-' + j.id;
        detailTr.style.display = 'none';
        const detailTd = document.createElement('td');
        detailTd.colSpan = 3;
        detailTd.innerHTML = '<div class="job-detail-panel" id="sa-detail-panel-' + j.id + '">불러오는 중...</div>';
        detailTr.appendChild(detailTd);
        body.appendChild(detailTr);
      }
    });

    document.getElementById('sa-run-link').innerHTML = data.run.htmlUrl
      ? '<a href="' + data.run.htmlUrl + '" target="_blank" rel="noopener">GitHub Actions에서 자세히 보기 →</a>'
      : '';

    if (data.run.status === 'completed' && saPolling) {
      clearInterval(saPolling);
      saPolling = null;
    }
  }

  function pollSiteAuditStatus() {
    fetch('/admin/site-audit/status')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        renderSiteAuditStatus(data);
        // 아직 진행 중이면 폴링을 계속 유지
        if (data.run && data.run.status !== 'completed' && !saPolling) {
          saPolling = setInterval(pollSiteAuditStatus, 5000);
        }
      })
      .catch(function () {});
  }

  const saDetailCache = {};

  function toggleSaDetail(jobId) {
    const row = document.getElementById('sa-detail-row-' + jobId);
    if (!row) return;
    if (row.style.display !== 'none') {
      row.style.display = 'none';
      return;
    }
    row.style.display = '';
    const panel = document.getElementById('sa-detail-panel-' + jobId);
    if (saDetailCache[jobId]) {
      panel.innerHTML = renderJobDetailHtml(saDetailCache[jobId]);
      return;
    }
    panel.innerHTML = '불러오는 중...';
    fetch('/admin/site-audit/job/' + jobId + '/detail')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        saDetailCache[jobId] = data;
        panel.innerHTML = renderJobDetailHtml(data);
      })
      .catch(function (err) {
        panel.innerHTML = '<div style="color:#dc2626; font-size:13px;">오류: ' + err.message + '</div>';
      });
  }

  pollSiteAuditStatus();
</script>

<h2>CI/CD 자동 테스트 실행 요청 (프론트 홈페이지 폼)</h2>
<div class="card">
  <p style="color:#6b7280; font-size:13px; margin-top:0;">
    단위테스트(Jest) → 통합/E2E테스트(Playwright) → 성능테스트(k6) → 보안점검(npm audit) 순서로 자동 실행되는
    파이프라인입니다. 홈페이지에서 제출된 요청은 GitHub Actions 실행(컴퓨팅 자원 소모)을 유발하므로,
    대상 URL·요청사항을 확인한 뒤 <strong>승인</strong>해야만 실제 실행이 시작되며, 반려하면 비용 없이 종료됩니다.
  </p>

  <div id="ci-not-configured" style="display:none; margin-top:12px; padding:12px; background:#fef3c7; border-radius:8px; font-size:13px;">
    GitHub 연동이 설정되지 않았습니다. Render 환경변수에 <code>GITHUB_TOKEN</code>(repo, workflow 스코프)과 <code>GITHUB_REPO</code>(예: momentoh/testops-advisor)를 추가해 주세요.
  </div>

  <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:12px; font-size:13px;">
    <label>기간:</label>
    <input type="date" id="ci-filter-from" style="padding:4px 8px; border:1px solid #d1d5db; border-radius:6px;">
    <span>~</span>
    <input type="date" id="ci-filter-to" style="padding:4px 8px; border:1px solid #d1d5db; border-radius:6px;">
    <button class="btn secondary" type="button" style="padding:4px 10px; font-size:12px;" onclick="applyCiFilter()">조회</button>
    <button class="btn secondary" type="button" style="padding:4px 10px; font-size:12px;" onclick="clearCiFilter()">전체보기</button>
    <span id="ci-filter-count" style="color:#6b7280;"></span>
  </div>
  <div id="ci-test-empty" style="display:none; color:#9ca3af; font-size:13px;">아직 제출된 실행 요청이 없습니다.</div>
  <table class="admin-table" id="ci-test-table" style="display:none;">
    <thead><tr><th>대상 URL</th><th>요청사항</th><th>요청 시각</th><th>상태</th><th>승인/반려</th></tr></thead>
    <tbody id="ci-test-body"></tbody>
  </table>
  <div id="ci-test-detail" style="display:none; margin-top:16px;"></div>
</div>

<script>
  const ciDetailCache = {};

  function renderJobDetailHtml(data) {
    if (!data.ok) {
      return '<div style="color:#dc2626; font-size:13px;">상세 정보를 불러오지 못했습니다: ' + (data.error || '알 수 없는 오류') + '</div>';
    }
    let html = '';
    if (data.testCases && data.testCases.length) {
      html += '<div style="font-weight:600; font-size:13px; margin-bottom:6px;">생성된 테스트케이스 (' + data.testCases.length + '개)</div>';
      html += '<ul class="job-testcase-list">';
      data.testCases.forEach(function (tc) {
        const icon = tc.status === 'pass' ? '✅' : '❌';
        const color = tc.status === 'pass' ? '#16a34a' : '#dc2626';
        html += '<li style="color:' + color + '">' + icon + ' ' + tc.name + '</li>';
      });
      html += '</ul>';
    }
    if (data.metrics && data.metrics.length) {
      html += '<div style="font-weight:600; font-size:13px; margin:10px 0 6px;">성능/지표 결과</div>';
      html += '<table class="admin-table job-metrics-table"><tbody>';
      data.metrics.forEach(function (m) {
        html += '<tr><td>' + m.label + '</td><td>' + m.value + '</td></tr>';
      });
      html += '</tbody></table>';
    }
    if (!(data.testCases && data.testCases.length) && !(data.metrics && data.metrics.length)) {
      html += '<div style="color:#9ca3af; font-size:13px;">추출된 테스트케이스/지표가 없습니다. 원본 로그를 확인해 주세요.</div>';
    }
    if (data.raw) {
      html += '<details style="margin-top:10px;"><summary style="cursor:pointer; font-size:12px; color:#6b7280;">원본 로그 보기 (마지막 200줄)</summary>' +
        '<pre style="max-height:300px; overflow:auto; background:#111827; color:#d1d5db; padding:10px; border-radius:6px; font-size:11px;">' +
        data.raw.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</pre></details>';
    }
    return html || '<div style="color:#9ca3af; font-size:13px;">표시할 상세 정보가 없습니다.</div>';
  }

  function ciTestStatusLabel(status) {
    if (status === 'done') return { text: '✅ 완료', color: '#16a34a' };
    if (status === 'error') return { text: '❌ 실패', color: '#dc2626' };
    if (status === 'running') return { text: '⏳ 실행 중', color: '#d97706' };
    if (status === 'pending_approval') return { text: '🔔 승인 대기', color: '#d97706' };
    if (status === 'rejected') return { text: '🚫 반려됨', color: '#6b7280' };
    return { text: status, color: '#6b7280' };
  }

  function ciTestFormatDuration(startedAt, completedAt) {
    if (!startedAt) return '-';
    const end = completedAt ? new Date(completedAt) : new Date();
    const sec = Math.max(0, Math.round((end - new Date(startedAt)) / 1000));
    return sec + '초';
  }

  function approveCiTest(id) {
    if (!confirm('이 요청을 승인하시겠습니까? 승인 시 GitHub Actions 실행(컴퓨팅 자원 소모)이 시작됩니다.')) return;
    fetch('/admin/ci-test/' + id + '/approve', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) { alert('오류: ' + (data.error || '알 수 없는 오류')); return; }
        pollCiTestList();
      })
      .catch(function (err) { alert('오류: ' + err.message); });
  }

  function rejectCiTest(id) {
    if (!confirm('이 요청을 반려하시겠습니까? 반려 시 GitHub Actions를 실행하지 않습니다.')) return;
    fetch('/admin/ci-test/' + id + '/reject', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason: '관리자가 반려했습니다.' }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) { alert('오류: ' + (data.error || '알 수 없는 오류')); return; }
        pollCiTestList();
      })
      .catch(function (err) { alert('오류: ' + err.message); });
  }

  function renderCiTestJobsTable(id, jobs) {
    let html = '<table class="admin-table" style="margin-top:10px;"><thead><tr><th>단계</th><th>상태</th><th>소요 시간</th></tr></thead><tbody>';
    (jobs || []).forEach(function (j) {
      const s = ciTestStatusLabelForJob(j.status, j.conclusion);
      const canDetail = j.status === 'completed';
      html += '<tr><td>' + j.name + '</td>' +
        '<td><span ' + (canDetail ? 'class="job-status-link" onclick="toggleCiTestJobDetail(\'' + id + '\',\'' + j.id + '\')"' : '') +
          ' style="color:' + s.color + (canDetail ? ';cursor:pointer;text-decoration:underline;' : '') + '">' + s.text + '</span></td>' +
        '<td>' + ciTestFormatDuration(j.startedAt, j.completedAt) + '</td></tr>' +
        '<tr id="ci-test-job-detail-row-' + j.id + '" style="display:none;"><td colspan="3"><div class="job-detail-panel" id="ci-test-job-detail-' + j.id + '">불러오는 중...</div></td></tr>';
    });
    html += '</tbody></table>';
    return html;
  }

  function ciTestStatusLabelForJob(status, conclusion) {
    if (status === 'completed') {
      if (conclusion === 'success') return { text: '✅ 통과', color: '#16a34a' };
      if (conclusion === 'failure') return { text: '❌ 실패', color: '#dc2626' };
      return { text: conclusion || status, color: '#6b7280' };
    }
    if (status === 'in_progress') return { text: '⏳ 진행 중', color: '#d97706' };
    if (status === 'queued') return { text: '⏳ 대기 중', color: '#6b7280' };
    return { text: status, color: '#6b7280' };
  }

  function toggleCiTestJobDetail(id, jobId) {
    const row = document.getElementById('ci-test-job-detail-row-' + jobId);
    if (!row) return;
    if (row.style.display !== 'none') { row.style.display = 'none'; return; }
    row.style.display = '';
    const panel = document.getElementById('ci-test-job-detail-' + jobId);
    if (ciDetailCache[jobId]) { panel.innerHTML = renderJobDetailHtml(ciDetailCache[jobId]); return; }
    panel.innerHTML = '불러오는 중...';
    fetch('/admin/ci-test/' + id + '/job/' + jobId + '/detail')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        ciDetailCache[jobId] = data;
        panel.innerHTML = renderJobDetailHtml(data);
      })
      .catch(function (err) {
        panel.innerHTML = '<div style="color:#dc2626; font-size:13px;">오류: ' + err.message + '</div>';
      });
  }

  let ciTestCache = {};
  let ciTestAllItems = [];
  let ciFilterFrom = null;
  let ciFilterTo = null;

  function applyCiFilter() {
    ciFilterFrom = document.getElementById('ci-filter-from').value || null;
    ciFilterTo = document.getElementById('ci-filter-to').value || null;
    renderCiTestList(ciTestAllItems);
  }

  function clearCiFilter() {
    document.getElementById('ci-filter-from').value = '';
    document.getElementById('ci-filter-to').value = '';
    ciFilterFrom = null;
    ciFilterTo = null;
    renderCiTestList(ciTestAllItems);
  }
  let ciTestDetailPolling = null;

  function renderCiTestDetail(item) {
    const box = document.getElementById('ci-test-detail');
    box.style.display = 'block';

    let html = '<p style="font-size:13px; background:#f9fafb; padding:10px 12px; border-radius:8px;">' +
      '<strong>대상 URL:</strong> ' + (item.targetUrl || '-') + '<br>' +
      '<strong>요청사항:</strong> ' + (item.requirements || '-').replace(/&/g, '&amp;').replace(/</g, '&lt;') +
      '</p>';

    if (item.status === 'pending_approval') {
      html += '<div style="margin-top:10px;">' +
        '<button class="btn" type="button" onclick="approveCiTest(\'' + item.id + '\')">승인 (실행 시작)</button> ' +
        '<button class="btn secondary" type="button" onclick="rejectCiTest(\'' + item.id + '\')">반려</button>' +
        '</div>';
      box.innerHTML = html;
      return;
    }
    if (item.status === 'rejected') {
      html += '<div style="color:#6b7280; font-size:13px;">🚫 반려된 요청입니다' + (item.error ? ' (' + item.error + ')' : '') + '. GitHub Actions가 실행되지 않았습니다.</div>';
      box.innerHTML = html;
      return;
    }

    // running | done | error: 실시간 잡 상태를 조회
    if (ciTestDetailPolling) { clearInterval(ciTestDetailPolling); ciTestDetailPolling = null; }
    html += '<div id="ci-test-run-status" style="font-size:13px; color:#6b7280;">실행 상태를 불러오는 중...</div>';
    html += '<div id="ci-test-run-jobs"></div>';
    box.innerHTML = html;

    function fetchRunStatus() {
      fetch('/admin/ci-test/' + item.id + '/run-status')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.ok) {
            document.getElementById('ci-test-run-status').textContent = '오류: ' + (data.error || '알 수 없는 오류');
            return;
          }
          if (!data.run) {
            document.getElementById('ci-test-run-status').textContent = '아직 GitHub Actions 실행을 연결하는 중입니다 (몇 초 후 자동 갱신됩니다).';
            return;
          }
          const s = ciTestStatusLabelForJob(data.run.status, data.run.conclusion);
          document.getElementById('ci-test-run-status').innerHTML =
            '전체 상태: <span style="color:' + s.color + '">' + s.text + '</span>' +
            (data.run.htmlUrl ? ' &middot; <a href="' + data.run.htmlUrl + '" target="_blank" rel="noopener">GitHub Actions에서 자세히 보기 →</a>' : '');
          document.getElementById('ci-test-run-jobs').innerHTML = renderCiTestJobsTable(item.id, data.jobs);

          if (data.run.status === 'completed' && ciTestDetailPolling) {
            clearInterval(ciTestDetailPolling);
            ciTestDetailPolling = null;
            pollCiTestList();
          }
        })
        .catch(function () {});
    }
    fetchRunStatus();
    ciTestDetailPolling = setInterval(fetchRunStatus, 5000);
  }

  function viewCiTestItem(id) {
    const item = ciTestCache[id];
    if (!item) return;
    renderCiTestDetail(item);
    document.getElementById('ci-test-detail').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderCiTestList(allItems) {
    const items = filterByDateRange(allItems, ciFilterFrom, ciFilterTo);
    const empty = document.getElementById('ci-test-empty');
    const table = document.getElementById('ci-test-table');
    const body = document.getElementById('ci-test-body');
    const countLabel = document.getElementById('ci-filter-count');

    countLabel.textContent = (ciFilterFrom || ciFilterTo)
      ? '(' + items.length + '건 / 전체 ' + allItems.length + '건)'
      : '';

    if (items.length === 0) {
      empty.style.display = 'block';
      empty.textContent = allItems.length === 0 ? '아직 제출된 실행 요청이 없습니다.' : '선택한 기간에 해당하는 이력이 없습니다.';
      table.style.display = 'none';
      return;
    }
    empty.style.display = 'none';
    table.style.display = '';
    body.innerHTML = '';
    ciTestCache = {};

    items.forEach(function (item) {
      ciTestCache[item.id] = item;
      const s = ciTestStatusLabel(item.status);
      const clickable = item.status !== 'pending_approval';
      const tr = document.createElement('tr');
      const reqShort = (item.requirements || '').length > 40 ? item.requirements.slice(0, 40) + '...' : (item.requirements || '-');
      tr.innerHTML =
        '<td>' + (item.targetUrl || '-') + '</td>' +
        '<td>' + reqShort.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</td>' +
        '<td>' + new Date(item.requestedAt).toLocaleString('ko-KR') + '</td>' +
        '<td><span ' + (clickable || item.status === 'pending_approval' ? 'class="job-status-link" onclick="viewCiTestItem(\'' + item.id + '\')" style="cursor:pointer; text-decoration:underline;"' : '') +
          ' style="color:' + s.color + '">' + s.text + '</span></td>' +
        '<td>' + (item.status === 'pending_approval'
          ? '<button class="btn" type="button" style="padding:2px 10px; font-size:12px;" onclick="approveCiTest(\'' + item.id + '\')">승인</button> ' +
            '<button class="btn secondary" type="button" style="padding:2px 10px; font-size:12px;" onclick="rejectCiTest(\'' + item.id + '\')">반려</button>'
          : '-') + '</td>';
      body.appendChild(tr);
    });
  }

  function pollCiTestList() {
    fetch('/ci-test/status')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        const notConfigured = document.getElementById('ci-not-configured');
        if (!data.configured) { notConfigured.style.display = 'block'; }
        else { notConfigured.style.display = 'none'; }

        const items = data.items || [];
        ciTestAllItems = items;
        renderCiTestList(items);
      })
      .catch(function () {});
  }

  pollCiTestList();
  setInterval(pollCiTestList, 8000);
</script>

<h2>피드백 학습 현황</h2>
<div class="stat-grid">
  <div class="stat-box"><div class="num"><%= stats.totalFeedback %></div><div class="label">총 피드백 수</div></div>
  <div class="stat-box"><div class="num" style="color:#16a34a"><%= stats.up %></div><div class="label">👍 도움됨</div></div>
  <div class="stat-box"><div class="num" style="color:#dc2626"><%= stats.down %></div><div class="label">👎 별로</div></div>
  <div class="stat-box"><div class="num"><%= tools.length %></div><div class="label">등록된 도구 수</div></div>
</div>

<h2>단계별 피드백 분포</h2>
<table class="admin-table">
  <thead><tr><th>단계</th><th>총 피드백</th><th>👍</th><th>👎</th></tr></thead>
  <tbody>
    <% stats.perStage.forEach(function(s) { %>
      <tr><td><%= s.stageName %></td><td><%= s.total %></td><td><%= s.up %></td><td><%= s.down %></td></tr>
    <% }) %>
  </tbody>
</table>

<h2>새 도구 추가</h2>
<div class="card">
  <form class="stack" method="POST" action="/admin/tools">
    <label>단계</label>
    <select name="stageId" required>
      <% stages.forEach(function(s) { %><option value="<%= s.id %>"><%= s.order %>. <%= s.name %></option><% }) %>
    </select>
    <label>도구 이름</label>
    <input type="text" name="name" required placeholder="예: Playwright">
    <label>카테고리</label>
    <select name="category">
      <option value="agent">자동화 에이전트</option>
      <option value="mcp">MCP</option>
      <option value="platform">플랫폼/SaaS</option>
    </select>
    <label>설명</label>
    <textarea name="description" rows="2" placeholder="이 도구가 어떤 역할을 하는지 설명"></textarea>
    <label>참고 URL</label>
    <input type="url" name="url" placeholder="https://...">
    <button class="btn" type="submit">추가</button>
  </form>
</div>

<h2>전체 도구 목록 (추천 점수순)</h2>
<table class="admin-table">
  <thead>
    <tr><th>단계</th><th>이름</th><th>카테고리</th><th>가중치</th><th>👍/👎</th><th>점수</th><th>관리</th></tr>
  </thead>
  <tbody>
    <% tools.forEach(function(tool) {
      const stage = stages.find(s => s.id === tool.stageId);
    %>
    <tr>
      <td><%= stage ? stage.name : tool.stageId %></td>
      <td><strong><%= tool.name %></strong><br><span style="color:#9ca3af; font-size:12px;"><%= tool.description %></span></td>
      <td><span class="badge <%= tool.category %>"><%= tool.category %></span></td>
      <td><%= tool.weight.toFixed(2) %></td>
      <td><%= tool.upvotes || 0 %> / <%= tool.downvotes || 0 %></td>
      <td><%= tool.score.toFixed(2) %></td>
      <td>
        <form method="POST" action="/admin/tools/<%= tool.id %>/delete" onsubmit="return confirm('삭제하시겠습니까?');">
          <button class="btn danger" type="submit" style="font-size:12px; padding:6px 10px;">삭제</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<h2>최근 피드백 로그</h2>
<table class="admin-table">
  <thead><tr><th>시각</th><th>도구</th><th>결과</th></tr></thead>
  <tbody>
    <% stats.recentFeedback.forEach(function(f) { %>
      <tr>
        <td style="font-size:12px; color:#6b7280;"><%= new Date(f.createdAt).toLocaleString('ko-KR') %></td>
        <td><%= f.toolName %></td>
        <td><%= f.vote === 'up' ? '👍 도움됨' : '👎 별로' %></td>
      </tr>
    <% }) %>
    <% if (stats.recentFeedback.length === 0) { %>
      <tr><td colspan="3" style="color:#9ca3af;">아직 피드백이 없습니다.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/foot') %>
