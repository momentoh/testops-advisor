<%- include('partials/head', { title }) %>

<div style="display:flex; justify-content:space-between; align-items:center;">
  <h1>관리자 대시보드</h1>
  <form method="POST" action="/admin/logout"><button class="btn secondary" type="submit">로그아웃</button></form>
</div>

<h2>피드백 학습 현황</h2>
<div class="stat-grid">
  <div class="stat-box"><div class="num"><%= stats.totalFeedback %></div><div class="label">총 피드백 수</div></div>
  <div class="stat-box"><div class="num" style="color:#16a34a"><%= stats.up %></div><div class="label">👍 도움됨</div></div>
  <div class="stat-box"><div class="num" style="color:#dc2626"><%= stats.down %></div><div class="label">👎 별로</div></div>
  <div class="stat-box"><div class="num"><%= tools.length %></div><div class="label">등록된 도구 수</div></div>
</div>

<h2>단계별 피드백 분포</h2>
<table class="admin-table">
  <thead><tr><th>단계</th><th>총 피드백</th><th>👍</th><th>👎</th></tr></thead>
  <tbody>
    <% stats.perStage.forEach(function(s) { %>
      <tr><td><%= s.stageName %></td><td><%= s.total %></td><td><%= s.up %></td><td><%= s.down %></td></tr>
    <% }) %>
  </tbody>
</table>

<h2>새 도구 추가</h2>
<div class="card">
  <form class="stack" method="POST" action="/admin/tools">
    <label>단계</label>
    <select name="stageId" required>
      <% stages.forEach(function(s) { %><option value="<%= s.id %>"><%= s.order %>. <%= s.name %></option><% }) %>
    </select>
    <label>도구 이름</label>
    <input type="text" name="name" required placeholder="예: Playwright">
    <label>카테고리</label>
    <select name="category">
      <option value="agent">자동화 에이전트</option>
      <option value="mcp">MCP</option>
      <option value="platform">플랫폼/SaaS</option>
    </select>
    <label>설명</label>
    <textarea name="description" rows="2" placeholder="이 도구가 어떤 역할을 하는지 설명"></textarea>
    <label>참고 URL</label>
    <input type="url" name="url" placeholder="https://...">
    <button class="btn" type="submit">추가</button>
  </form>
</div>

<h2>전체 도구 목록 (추천 점수순)</h2>
<table class="admin-table">
  <thead>
    <tr><th>단계</th><th>이름</th><th>카테고리</th><th>가중치</th><th>👍/👎</th><th>점수</th><th>관리</th></tr>
  </thead>
  <tbody>
    <% tools.forEach(function(tool) {
      const stage = stages.find(s => s.id === tool.stageId);
    %>
    <tr>
      <td><%= stage ? stage.name : tool.stageId %></td>
      <td><strong><%= tool.name %></strong><br><span style="color:#9ca3af; font-size:12px;"><%= tool.description %></span></td>
      <td><span class="badge <%= tool.category %>"><%= tool.category %></span></td>
      <td><%= tool.weight.toFixed(2) %></td>
      <td><%= tool.upvotes || 0 %> / <%= tool.downvotes || 0 %></td>
      <td><%= tool.score.toFixed(2) %></td>
      <td>
        <form method="POST" action="/admin/tools/<%= tool.id %>/delete" onsubmit="return confirm('삭제하시겠습니까?');">
          <button class="btn danger" type="submit" style="font-size:12px; padding:6px 10px;">삭제</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<h2>최근 피드백 로그</h2>
<table class="admin-table">
  <thead><tr><th>시각</th><th>도구</th><th>결과</th></tr></thead>
  <tbody>
    <% stats.recentFeedback.forEach(function(f) { %>
      <tr>
        <td style="font-size:12px; color:#6b7280;"><%= new Date(f.createdAt).toLocaleString('ko-KR') %></td>
        <td><%= f.toolName %></td>
        <td><%= f.vote === 'up' ? '👍 도움됨' : '👎 별로' %></td>
      </tr>
    <% }) %>
    <% if (stats.recentFeedback.length === 0) { %>
      <tr><td colspan="3" style="color:#9ca3af;">아직 피드백이 없습니다.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/foot') %>
