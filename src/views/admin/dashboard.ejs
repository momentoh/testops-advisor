<%- include('partials/head', { title }) %>

<div style="display:flex; justify-content:space-between; align-items:center;">
  <h1>관리자 대시보드</h1>
  <form method="POST" action="/admin/logout"><button class="btn secondary" type="submit">로그아웃</button></form>
</div>

<h2>CI/CD 파이프라인 (1순위 도구 자동 검증)</h2>
<div class="card">
  <p style="color:#6b7280; font-size:13px; margin-top:0;">
    단위테스트(Jest) → 통합/E2E테스트(Playwright) → 성능테스트(k6) → 보안점검(npm audit) 순서로 자동 실행됩니다.
  </p>
  <button class="btn" id="ci-run-btn" type="button" onclick="runCiPipeline()">▶ 테스트 실행</button>
  <span id="ci-status-text" style="margin-left:12px; font-size:13px; color:#6b7280;"></span>

  <div id="ci-not-configured" style="display:none; margin-top:12px; padding:12px; background:#fef3c7; border-radius:8px; font-size:13px;">
    GitHub 연동이 설정되지 않았습니다. Render 환경변수에 <code>GITHUB_TOKEN</code>(repo, workflow 스코프)과 <code>GITHUB_REPO</code>(예: momentoh/testops-advisor)를 추가해 주세요.
  </div>

  <table class="admin-table" id="ci-jobs-table" style="display:none; margin-top:16px;">
    <thead><tr><th>단계</th><th>상태</th><th>소요 시간</th></tr></thead>
    <tbody id="ci-jobs-body"></tbody>
  </table>
  <div id="ci-run-link" style="margin-top:10px; font-size:13px;"></div>
</div>

<script>
  let ciPolling = null;

  function ciStatusLabel(status, conclusion) {
    if (status === 'completed') {
      if (conclusion === 'success') return { text: '✅ 통과', color: '#16a34a' };
      if (conclusion === 'failure') return { text: '❌ 실패', color: '#dc2626' };
      return { text: conclusion || status, color: '#6b7280' };
    }
    if (status === 'in_progress') return { text: '⏳ 진행 중', color: '#d97706' };
    if (status === 'queued') return { text: '⏳ 대기 중', color: '#6b7280' };
    return { text: status, color: '#6b7280' };
  }

  function formatDuration(startedAt, completedAt) {
    if (!startedAt) return '-';
    const end = completedAt ? new Date(completedAt) : new Date();
    const sec = Math.max(0, Math.round((end - new Date(startedAt)) / 1000));
    return sec + '초';
  }

  function renderCiStatus(data) {
    const notConfigured = document.getElementById('ci-not-configured');
    const table = document.getElementById('ci-jobs-table');
    const body = document.getElementById('ci-jobs-body');
    const linkBox = document.getElementById('ci-run-link');
    const statusText = document.getElementById('ci-status-text');

    if (!data.configured) {
      notConfigured.style.display = 'block';
      table.style.display = 'none';
      statusText.textContent = '';
      return;
    }
    notConfigured.style.display = 'none';

    if (!data.run) {
      statusText.textContent = '아직 실행 이력이 없습니다.';
      return;
    }

    const overall = ciStatusLabel(data.run.status, data.run.conclusion);
    statusText.textContent = '전체 상태: ' + overall.text;
    statusText.style.color = overall.color;

    table.style.display = '';
    body.innerHTML = '';
    (data.jobs || []).forEach(function (j) {
      const s = ciStatusLabel(j.status, j.conclusion);
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + j.name + '</td>' +
        '<td style="color:' + s.color + '">' + s.text + '</td>' +
        '<td>' + formatDuration(j.startedAt, j.completedAt) + '</td>';
      body.appendChild(tr);
    });

    linkBox.innerHTML = data.run.htmlUrl
      ? '<a href="' + data.run.htmlUrl + '" target="_blank" rel="noopener">GitHub Actions에서 자세히 보기 →</a>'
      : '';

    if (data.run.status === 'completed' && ciPolling) {
      clearInterval(ciPolling);
      ciPolling = null;
      document.getElementById('ci-run-btn').disabled = false;
    }
  }

  function pollCiStatus() {
    fetch('/admin/ci/status')
      .then(function (r) { return r.json(); })
      .then(renderCiStatus)
      .catch(function () {
        document.getElementById('ci-status-text').textContent = '상태 조회 중 오류가 발생했습니다.';
      });
  }

  function runCiPipeline() {
    const btn = document.getElementById('ci-run-btn');
    btn.disabled = true;
    document.getElementById('ci-status-text').textContent = '테스트를 시작하는 중...';

    fetch('/admin/ci/trigger', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) {
          document.getElementById('ci-status-text').textContent = '오류: ' + (data.error || '알 수 없는 오류');
          btn.disabled = false;
          return;
        }
        // GitHub가 실행을 등록하는 데 몇 초 걸리므로 잠시 기다린 뒤 폴링 시작
        setTimeout(function () {
          if (ciPolling) clearInterval(ciPolling);
          ciPolling = setInterval(pollCiStatus, 4000);
          pollCiStatus();
        }, 4000);
      })
      .catch(function (err) {
        document.getElementById('ci-status-text').textContent = '오류: ' + err.message;
        btn.disabled = false;
      });
  }

  // 페이지 로드 시 최근 실행 상태를 한 번 조회
  pollCiStatus();
</script>

<h2>피드백 학습 현황</h2>
<div class="stat-grid">
  <div class="stat-box"><div class="num"><%= stats.totalFeedback %></div><div class="label">총 피드백 수</div></div>
  <div class="stat-box"><div class="num" style="color:#16a34a"><%= stats.up %></div><div class="label">👍 도움됨</div></div>
  <div class="stat-box"><div class="num" style="color:#dc2626"><%= stats.down %></div><div class="label">👎 별로</div></div>
  <div class="stat-box"><div class="num"><%= tools.length %></div><div class="label">등록된 도구 수</div></div>
</div>

<h2>단계별 피드백 분포</h2>
<table class="admin-table">
  <thead><tr><th>단계</th><th>총 피드백</th><th>👍</th><th>👎</th></tr></thead>
  <tbody>
    <% stats.perStage.forEach(function(s) { %>
      <tr><td><%= s.stageName %></td><td><%= s.total %></td><td><%= s.up %></td><td><%= s.down %></td></tr>
    <% }) %>
  </tbody>
</table>

<h2>새 도구 추가</h2>
<div class="card">
  <form class="stack" method="POST" action="/admin/tools">
    <label>단계</label>
    <select name="stageId" required>
      <% stages.forEach(function(s) { %><option value="<%= s.id %>"><%= s.order %>. <%= s.name %></option><% }) %>
    </select>
    <label>도구 이름</label>
    <input type="text" name="name" required placeholder="예: Playwright">
    <label>카테고리</label>
    <select name="category">
      <option value="agent">자동화 에이전트</option>
      <option value="mcp">MCP</option>
      <option value="platform">플랫폼/SaaS</option>
    </select>
    <label>설명</label>
    <textarea name="description" rows="2" placeholder="이 도구가 어떤 역할을 하는지 설명"></textarea>
    <label>참고 URL</label>
    <input type="url" name="url" placeholder="https://...">
    <button class="btn" type="submit">추가</button>
  </form>
</div>

<h2>전체 도구 목록 (추천 점수순)</h2>
<table class="admin-table">
  <thead>
    <tr><th>단계</th><th>이름</th><th>카테고리</th><th>가중치</th><th>👍/👎</th><th>점수</th><th>관리</th></tr>
  </thead>
  <tbody>
    <% tools.forEach(function(tool) {
      const stage = stages.find(s => s.id === tool.stageId);
    %>
    <tr>
      <td><%= stage ? stage.name : tool.stageId %></td>
      <td><strong><%= tool.name %></strong><br><span style="color:#9ca3af; font-size:12px;"><%= tool.description %></span></td>
      <td><span class="badge <%= tool.category %>"><%= tool.category %></span></td>
      <td><%= tool.weight.toFixed(2) %></td>
      <td><%= tool.upvotes || 0 %> / <%= tool.downvotes || 0 %></td>
      <td><%= tool.score.toFixed(2) %></td>
      <td>
        <form method="POST" action="/admin/tools/<%= tool.id %>/delete" onsubmit="return confirm('삭제하시겠습니까?');">
          <button class="btn danger" type="submit" style="font-size:12px; padding:6px 10px;">삭제</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<h2>최근 피드백 로그</h2>
<table class="admin-table">
  <thead><tr><th>시각</th><th>도구</th><th>결과</th></tr></thead>
  <tbody>
    <% stats.recentFeedback.forEach(function(f) { %>
      <tr>
        <td style="font-size:12px; color:#6b7280;"><%= new Date(f.createdAt).toLocaleString('ko-KR') %></td>
        <td><%= f.toolName %></td>
        <td><%= f.vote === 'up' ? '👍 도움됨' : '👎 별로' %></td>
      </tr>
    <% }) %>
    <% if (stats.recentFeedback.length === 0) { %>
      <tr><td colspan="3" style="color:#9ca3af;">아직 피드백이 없습니다.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/foot') %>
